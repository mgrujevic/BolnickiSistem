<UserControl x:Class="BolnickiSistem.Views.Admin.KorisniciView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#F5F7FA">

    <UserControl.Resources>

        <!-- BOJA TEKSTA -->
        <SolidColorBrush x:Key="GlavnaBoja" Color="#1F2937"/>
        <SolidColorBrush x:Key="SporednaBoja" Color="#6B7280"/>
        <SolidColorBrush x:Key="PlavaBoja" Color="#2563EB"/>
        <SolidColorBrush x:Key="ZelenaBoja" Color="#16A34A"/>
        <SolidColorBrush x:Key="CrvenaBoja" Color="#DC2626"/>


        <!-- TEXTBOX -->

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Margin" Value="0,6,0,16"/>
        </Style>


        <!-- COMBOBOX -->

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Margin" Value="0,6,0,16"/>
        </Style>


        <!-- DUGME -->

        <Style TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>


        <!-- DATAGRID -->

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowHeight" Value="42"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E5E7EB"/>
            <Setter Property="VerticalGridLinesBrush" Value="#E5E7EB"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
        </Style>


        <!-- DATAGRID HEADER -->

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
        </Style>


        <!-- DATAGRID RED -->

        <Style TargetType="DataGridRow">

            <Setter Property="Background" Value="White"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                </Trigger>

                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DBEAFE"/>
                    <Setter Property="Foreground" Value="#1E3A8A"/>
                </Trigger>

            </Style.Triggers>

        </Style>

    </UserControl.Resources>


    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- NASLOV -->

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,24">

            <TextBlock Text="Korisnici"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="{StaticResource GlavnaBoja}"/>

            <TextBlock Text="Upravljanje korisničkim nalozima sistema"
                       FontSize="14"
                       Foreground="{StaticResource SporednaBoja}"
                       Margin="0,6,0,0"/>

        </StackPanel>


        <!-- GLAVNI SADRŽAJ -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="1.65*"/>

                <ColumnDefinition Width="1*"/>

            </Grid.ColumnDefinitions>


            <!-- ========================= -->
            <!-- TABELA KORISNIKA -->
            <!-- ========================= -->

            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="12"
                    Padding="15"
                    Margin="0,0,15,0">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>


                    <!-- NASLOV TABELE -->

                    <Grid Grid.Row="0"
                          Margin="5,0,5,12">

                        <StackPanel>

                            <TextBlock Text="Lista korisnika"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource GlavnaBoja}"/>

                            <TextBlock Text="Registrovani korisnici sistema"
                                       FontSize="12"
                                       Foreground="{StaticResource SporednaBoja}"
                                       Margin="0,3,0,0"/>

                        </StackPanel>

                    </Grid>


                    <!-- TABELA -->

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Korisnici}"
                              SelectedItem="{Binding IzabraniKorisnik}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Korisničko ime"
                                                Binding="{Binding KorisnickoIme}"
                                                Width="1.2*"/>

                            <DataGridTextColumn Header="Ime"
                                                Binding="{Binding Ime}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Prezime"
                                                Binding="{Binding Prezime}"
                                                Width="1.2*"/>

                            <DataGridTextColumn Header="Uloga"
                                                Binding="{Binding Uloga.Naziv}"
                                                Width="1.1*"/>

                            <DataGridCheckBoxColumn Header="Aktivan"
                                                   Binding="{Binding Aktivan}"
                                                   Width="75"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>


            <!-- ========================= -->
            <!-- FORMA -->
            <!-- ========================= -->

            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="12"
                    Padding="25">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel>


                        <!-- NASLOV -->

                        <TextBlock Text="Podaci o korisniku"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource GlavnaBoja}"
                                   Margin="0,0,0,5"/>

                        <TextBlock Text="Dodavanje i izmena korisnika"
                                   FontSize="12"
                                   Foreground="{StaticResource SporednaBoja}"
                                   Margin="0,0,0,22"/>


                        <!-- KORISNIČKO IME -->

                        <TextBlock Text="Korisničko ime"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#374151"/>

                        <TextBox Text="{Binding KorisnickoIme,
                                                UpdateSourceTrigger=PropertyChanged}"/>


                        <!-- LOZINKA -->

                        <TextBlock Text="Lozinka"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#374151"/>

                        <TextBox Text="{Binding Lozinka,
                                                UpdateSourceTrigger=PropertyChanged}"/>


                        <!-- IME -->

                        <TextBlock Text="Ime"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#374151"/>

                        <TextBox Text="{Binding Ime,
                                                UpdateSourceTrigger=PropertyChanged}"/>


                        <!-- PREZIME -->

                        <TextBlock Text="Prezime"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#374151"/>

                        <TextBox Text="{Binding Prezime,
                                                UpdateSourceTrigger=PropertyChanged}"/>


                        <!-- EMAIL -->

                        <TextBlock Text="Email"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#374151"/>

                        <TextBox Text="{Binding Email,
                                                UpdateSourceTrigger=PropertyChanged}"/>


                        <!-- ULOGA -->

                        <TextBlock Text="Uloga"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#374151"/>

                        <ComboBox ItemsSource="{Binding Uloge}"
                                  DisplayMemberPath="Naziv"
                                  SelectedValuePath="UlogaId"
                                  SelectedValue="{Binding IzabranaUlogaId}"/>


                        <!-- AKTIVAN -->

                        <CheckBox Content="Korisnik je aktivan"
                                  IsChecked="{Binding Aktivan}"
                                  FontSize="13"
                                  Foreground="#374151"
                                  Margin="0,0,0,22"/>


                        <!-- GLAVNA DUGMAD -->

                        <Grid Margin="0,0,0,10">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>


                            <Button Grid.Column="0"
                                    Content="Novi korisnik"
                                    Command="{Binding NoviKorisnikCommand}"
                                    Background="#E5E7EB"
                                    Foreground="#374151"
                                    Margin="0,0,5,0"/>


                            <Button Grid.Column="1"
                                    Content="Sačuvaj"
                                    Command="{Binding SacuvajCommand}"
                                    Background="{StaticResource PlavaBoja}"
                                    Foreground="White"
                                    Margin="5,0,0,0"/>

                        </Grid>


                        <!-- DODATNE AKCIJE -->

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="1.4*"/>

                                <ColumnDefinition Width="1*"/>

                            </Grid.ColumnDefinitions>


                            <Button Grid.Column="0"
                                    Content="Aktiviraj / Deaktiviraj"
                                    Command="{Binding AktivirajDeaktivirajCommand}"
                                    Background="#E8F5E9"
                                    Foreground="#15803D"
                                    Margin="0,0,5,0"/>


                            <Button Grid.Column="1"
                                    Content="Obriši"
                                    Command="{Binding ObrisiCommand}"
                                    Background="#FEE2E2"
                                    Foreground="{StaticResource CrvenaBoja}"
                                    Margin="5,0,0,0"/>

                        </Grid>


                        <!-- PORUKA -->

                        <Border Background="#F8FAFC"
                                CornerRadius="6"
                                Padding="10"
                                Margin="0,18,0,0">

                            <TextBlock Text="{Binding Poruka}"
                                       Foreground="{StaticResource SporednaBoja}"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

            </Border>

        </Grid>

    </Grid>

</UserControl>