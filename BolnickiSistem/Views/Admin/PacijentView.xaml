<UserControl x:Class="BolnickiSistem.Views.Admin.PacijentiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#F5F7FA">

    <UserControl.Resources>

        <SolidColorBrush x:Key="GlavnaBoja" Color="#1F2937"/>
        <SolidColorBrush x:Key="SporednaBoja" Color="#6B7280"/>
        <SolidColorBrush x:Key="PlavaBoja" Color="#2563EB"/>
        <SolidColorBrush x:Key="CrvenaBoja" Color="#DC2626"/>


        <!-- TEXTBOX -->

        <Style TargetType="TextBox">

            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Margin" Value="0,5,0,13"/>

        </Style>


        <!-- COMBOBOX -->

        <Style TargetType="ComboBox">

            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Margin" Value="0,5,0,13"/>

        </Style>


        <!-- BUTTON -->

        <Style TargetType="Button">

            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="BorderThickness" Value="0"/>

        </Style>


        <!-- DATAGRID -->

        <Style TargetType="DataGrid">

            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowHeight" Value="42"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush"
                    Value="#E5E7EB"/>
            <Setter Property="VerticalGridLinesBrush"
                    Value="#E5E7EB"/>
            <Setter Property="HeadersVisibility"
                    Value="Column"/>
            <Setter Property="CanUserResizeRows"
                    Value="False"/>

        </Style>


        <!-- HEADER TABELE -->

        <Style TargetType="DataGridColumnHeader">

            <Setter Property="Background"
                    Value="#F8FAFC"/>

            <Setter Property="Foreground"
                    Value="#374151"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Padding"
                    Value="10,0"/>

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="BorderThickness"
                    Value="0,0,0,1"/>

            <Setter Property="BorderBrush"
                    Value="#E5E7EB"/>

        </Style>


        <!-- RED -->

        <Style TargetType="DataGridRow">

            <Setter Property="Background"
                    Value="White"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#F1F5F9"/>

                </Trigger>

                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="#DBEAFE"/>

                    <Setter Property="Foreground"
                            Value="#1E3A8A"/>

                </Trigger>

            </Style.Triggers>

        </Style>

    </UserControl.Resources>


    <Grid Margin="25">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- NASLOV -->

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,18">

            <TextBlock Text="Pacijenti"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="{StaticResource GlavnaBoja}"/>

            <TextBlock Text="Pregled i upravljanje podacima pacijenata"
                       FontSize="14"
                       Foreground="{StaticResource SporednaBoja}"
                       Margin="0,5,0,0"/>

        </StackPanel>


        <!-- PRETRAGA -->

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="10"
                Padding="15"
                Margin="0,0,0,15">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="120"/>

                    <ColumnDefinition Width="120"/>

                </Grid.ColumnDefinitions>


                <TextBox Grid.Column="0"
                         Text="{Binding Pretraga,
                                        UpdateSourceTrigger=PropertyChanged}"
                         Height="38"
                         Margin="0"
                         ToolTip="Ime, prezime, JMBG ili broj zdravstvene kartice"/>


                <Button Grid.Column="1"
                        Content="Pretraži"
                        Command="{Binding PretraziCommand}"
                        Background="{StaticResource PlavaBoja}"
                        Foreground="White"
                        Margin="10,0,0,0"/>


                <Button Grid.Column="2"
                        Content="Novi pacijent"
                        Command="{Binding NoviPacijentCommand}"
                        Background="#E5E7EB"
                        Foreground="#374151"
                        Margin="10,0,0,0"/>

            </Grid>

        </Border>


        <!-- GLAVNI SADRŽAJ -->

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="1.65*"/>

                <ColumnDefinition Width="1*"/>

            </Grid.ColumnDefinitions>


            <!-- TABELA -->

            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="12"
                    Padding="15"
                    Margin="0,0,15,0">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>


                    <StackPanel Grid.Row="0"
                                Margin="5,0,5,12">

                        <TextBlock Text="Lista pacijenata"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource GlavnaBoja}"/>

                        <TextBlock Text="Registrovani pacijenti"
                                   FontSize="12"
                                   Foreground="{StaticResource SporednaBoja}"
                                   Margin="0,3,0,0"/>

                    </StackPanel>


                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Pacijenti}"
                              SelectedItem="{Binding IzabraniPacijent}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Ime"
                                                Binding="{Binding Ime}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Prezime"
                                                Binding="{Binding Prezime}"
                                                Width="1.2*"/>

                            <DataGridTextColumn Header="JMBG"
                                                Binding="{Binding JMBG}"
                                                Width="1.3*"/>

                            <DataGridTextColumn Header="Br. kartice"
                                                Binding="{Binding BrojZdravstveneKartice}"
                                                Width="1.2*"/>

                            <DataGridTextColumn Header="Pol"
                                                Binding="{Binding Pol}"
                                                Width="75"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>


            <!-- FORMA -->

            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="12"
                    Padding="22">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel>

                        <TextBlock Text="Podaci o pacijentu"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource GlavnaBoja}"/>

                        <TextBlock Text="Dodavanje i izmena podataka"
                                   FontSize="12"
                                   Foreground="{StaticResource SporednaBoja}"
                                   Margin="0,4,0,18"/>


                        <!-- BROJ KARTICE -->

                        <TextBlock Text="Broj zdravstvene kartice"
                                   FontWeight="SemiBold"
                                   FontSize="13"/>

                        <TextBox Text="{Binding BrojZdravstveneKartice,
                                                UpdateSourceTrigger=PropertyChanged}"/>


                        <!-- JMBG -->

                        <TextBlock Text="JMBG"
                                   FontWeight="SemiBold"
                                   FontSize="13"/>

                        <TextBox Text="{Binding JMBG,
                                                UpdateSourceTrigger=PropertyChanged}"/>


                        <!-- IME -->

                        <TextBlock Text="Ime"
                                   FontWeight="SemiBold"
                                   FontSize="13"/>

                        <TextBox Text="{Binding Ime,
                                                UpdateSourceTrigger=PropertyChanged}"/>


                        <!-- PREZIME -->

                        <TextBlock Text="Prezime"
                                   FontWeight="SemiBold"
                                   FontSize="13"/>

                        <TextBox Text="{Binding Prezime,
                                                UpdateSourceTrigger=PropertyChanged}"/>


                        <!-- DATUM -->

                        <TextBlock Text="Datum rođenja"
                                   FontWeight="SemiBold"
                                   FontSize="13"/>

                        <DatePicker SelectedDate="{Binding DatumRodjenja,
                                   Mode=TwoWay,
                                   UpdateSourceTrigger=PropertyChanged}"
                                    Height="36"
                                    Margin="0,5,0,13"/>             


                        <!-- POL -->

                        <TextBlock Text="Pol"
                                   FontWeight="SemiBold"
                                   FontSize="13"/>

                        <ComboBox ItemsSource="{Binding Polovi}"
                                SelectedItem="{Binding Pol,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"/>

                        <!-- DODELJENI LEKAR -->

                        <TextBlock Text="Dodeljeni lekar"
                                    FontWeight="SemiBold"
                                    FontSize="13"/>      

                        <ComboBox ItemsSource="{Binding Lekari}"
                                DisplayMemberPath="ImePrezime"
                                SelectedValuePath="KorisnikId"
                                SelectedValue="{Binding IzabraniLekarId,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"/>


                        <!-- ADRESA -->

                        <TextBlock Text="Adresa"
                                   FontWeight="SemiBold"
                                   FontSize="13"/>

                        <TextBox Text="{Binding Adresa,
                                                UpdateSourceTrigger=PropertyChanged}"/>


                        <!-- TELEFON -->

                        <TextBlock Text="Telefon"
                                   FontWeight="SemiBold"
                                   FontSize="13"/>

                        <TextBox Text="{Binding Telefon,
                                                UpdateSourceTrigger=PropertyChanged}"/>


                        <!-- EMAIL -->

                        <TextBlock Text="Email"
                                   FontWeight="SemiBold"
                                   FontSize="13"/>

                        <TextBox Text="{Binding Email,
                                                UpdateSourceTrigger=PropertyChanged}"/>


                        <!-- KRVNA GRUPA -->

                        <TextBlock Text="Krvna grupa"
                                   FontWeight="SemiBold"
                                   FontSize="13"/>

                        <ComboBox ItemsSource="{Binding KrvneGrupe}"
                                SelectedItem="{Binding KrvnaGrupa,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"/>


                        <!-- ALERGIJE -->

                        <TextBlock Text="Alergije"
                                   FontWeight="SemiBold"
                                   FontSize="13"/>

                        <TextBox Text="{Binding Alergije,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 Height="60"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 Padding="10,8"/>


                        <!-- HRONIČNE BOLESTI -->

                        <TextBlock Text="Hronične bolesti"
                                   FontWeight="SemiBold"
                                   FontSize="13"/>

                        <TextBox Text="{Binding HronicneBolesti,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 Height="60"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 Padding="10,8"/>


                        <!-- DUGMAD -->

                        <Grid Margin="0,5,0,0">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>


                            <Button Grid.Column="0"
                                    Content="Novi"
                                    Command="{Binding NoviPacijentCommand}"
                                    Background="#E5E7EB"
                                    Foreground="#374151"
                                    Margin="0,0,5,0"/>


                            <Button Grid.Column="1"
                                    Content="Sačuvaj"
                                    Command="{Binding SacuvajCommand}"
                                    Background="{StaticResource PlavaBoja}"
                                    Foreground="White"
                                    Margin="5,0,0,0"/>

                        </Grid>


                        <Button Content="Obriši pacijenta"
                                Command="{Binding ObrisiCommand}"
                                Background="#FEE2E2"
                                Foreground="{StaticResource CrvenaBoja}"
                                Margin="0,10,0,0"/>


                        <!-- PORUKA -->

                        <Border Background="#F8FAFC"
                                CornerRadius="6"
                                Padding="10"
                                Margin="0,15,0,0">

                            <TextBlock Text="{Binding Poruka}"
                                       Foreground="{StaticResource SporednaBoja}"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

            </Border>

        </Grid>

    </Grid>

</UserControl>